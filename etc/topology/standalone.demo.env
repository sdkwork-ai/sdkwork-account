# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_account_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_account_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_ACCOUNT_DEPLOYMENT_PROFILE=standalone
SDKWORK_ACCOUNT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_ACCOUNT_PROFILE_ID=standalone.demo
SDKWORK_ACCOUNT_APPLICATION_PUBLIC_HTTP_URL=https://account-demo.sdkwork.com
SDKWORK_ACCOUNT_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_ACCOUNT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://account-demo.sdkwork.com,http://account-demo.sdkwork.com,https://account-demo.birdcoder.com,http://account-demo.birdcoder.com,https://account-demo.dtupay.com,http://account-demo.dtupay.com,https://account-demo.noaper.com,http://account-demo.noaper.com,https://account-demo.sdkwork.cn,http://account-demo.sdkwork.cn,https://account-demo.birdcoder.cn,http://account-demo.birdcoder.cn,https://account-demo.dtupay.cn,http://account-demo.dtupay.cn,https://account-demo.noaper.cn,http://account-demo.noaper.cn,https://account-demo.skubc.com,http://account-demo.skubc.com,https://account-demo.skubc.cn,http://account-demo.skubc.cn,https://account-demo.zowalk.com,http://account-demo.zowalk.com,https://account-demo.zowalk.cn,http://account-demo.zowalk.cn,https://account-demo.offer86.com,http://account-demo.offer86.com,https://account-demo.offer86.cn,http://account-demo.offer86.cn,https://account-demo.86offer.com,http://account-demo.86offer.com,https://account-demo.86offer.cn,http://account-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
