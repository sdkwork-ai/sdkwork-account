{
  "license": "AGPL-3.0-or-later",
  "name": "sdkwork-account-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "stop": "node ../sdkwork-specs/tools/stop-sdkwork-workspace-processes.mjs --workspace .",
    "dev": "pnpm --dir apps/sdkwork-account-pc dev",
    "build": "pnpm --dir apps/sdkwork-account-pc build",
    "start": "cargo run -p sdkwork-api-account-standalone-gateway --bin sdkwork-api-account-standalone-gateway",
    "test": "pnpm test:node && pnpm test:vitest && cargo test --workspace",
    "test:node": "node --test --test-reporter=spec tests/static/placeholder.test.mjs",
    "test:vitest": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --configLoader native --pool forks",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test:vitest && cargo test --workspace && pnpm run check:app-composition && pnpm run check:pagination && pnpm run check:api-envelope && pnpm check:cors-standard",
    "check:pagination": "node ../sdkwork-specs/tools/check-pagination.mjs --workspace .",
    "check:cors-standard": "node ../sdkwork-specs/tools/check-cors-standard.mjs --root .",
    "check:api-envelope": "node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
    "format:check": "cargo fmt -p sdkwork-account-database-host -p sdkwork-api-account-assembly -p sdkwork-account-repository-sqlx -p sdkwork-account-service -p sdkwork-account-service-host -p sdkwork-api-account-standalone-gateway -p sdkwork-contract-service -p sdkwork-routes-account-app-api -p sdkwork-routes-account-backend-api -- --check",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "check": "pnpm run check:app-composition && pnpm db:validate && pnpm api:assembly:validate && pnpm typecheck",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_account_baseline.sql --module-id account --owner sdkwork-account --prefixes acct_ --engines postgres",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "sync:openapi": "node scripts/sync-account-openapi-to-sdks.mjs",
    "sdk:generate": "node sdks/sdkwork-account-app-sdk/bin/generate-sdk.mjs && node sdks/sdkwork-account-backend-sdk/bin/generate-sdk.mjs",
    "sdk:generate:app": "node sdks/sdkwork-account-app-sdk/bin/generate-sdk.mjs",
    "sdk:generate:backend": "node sdks/sdkwork-account-backend-sdk/bin/generate-sdk.mjs",
    "db:postgres:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan --engine postgres",
    "db:postgres:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init --engine postgres",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json"
  },
  "devDependencies": {
    "@sdkwork/appbase-pc-react": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "lucide-react": "^1.7.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "pnpm": {
    "overrides": {
      "@sdkwork/sdk-common": "workspace:*"
    }
  }
}
